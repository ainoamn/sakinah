 export const dynamic='force-dynamic';
+/* Best-effort per-user write throttling (in-isolate sliding window). */
+const WINDOW_MS=60000,MAX_WRITES=90,limiter=new Map<string,number[]>();
+function rateLimited(userId:string):boolean{const now=Date.now();const stamps=(limiter.get(userId)||[]).filter(t=>now-t<WINDOW_MS);if(stamps.length>=MAX_WRITES)return true;stamps.push(now);limiter.set(userId,stamps);if(limiter.size>10000)limiter.clear();return false}
+/* Opportunistic retention: drop activity rows older than 90 days (~10% of writes). */
+async function pruneActivities(db:ReturnType<typeof getDb>,userId:string){if(Math.random()>=0.1)return;await db.delete(activities).where(and(eq(activities.userId,userId),lt(activities.createdAt,Date.now()-90*86400000))).catch(()=>{})}
